{
  "name": "api-contract",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "api-contract",
  "tags": ["type:contract"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/openapi.yaml", "{projectRoot}/redocly.yaml"],
      "options": {
        "command": "redocly lint openapi.yaml",
        "cwd": "api-contract"
      }
    }
  }
}
