{
  "title": "Todo – services",
  "uid": "todo-services",
  "description": "java-api and notification-service on GKE: traffic, latency, errors, database pool, memory, CPU. Metrics from k8s/overlays/prod/pod-monitoring.yaml and GKE system metrics.",
  "editable": true,
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "type": "row",
      "title": "Traffic (what the users see)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Requests per second (/api)",
      "description": "rate() of the request counter: how many requests per second each service answers.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{namespace=\"todo\", uri=~\"/api.*\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95 (/api)",
      "description": "95 % of the requests were faster than this. Computed from the SLO buckets 50 ms … 5 s, so values between two buckets are interpolated.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_requests_seconds_bucket{namespace=\"todo\", uri=~\"/api.*\"}[$__rate_interval])))",
          "legendFormat": "{{job}} p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (job, le) (rate(http_server_requests_seconds_bucket{namespace=\"todo\", uri=~\"/api.*\"}[$__rate_interval])))",
          "legendFormat": "{{job}} p50"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors per second (5xx)",
      "description": "Server errors. 4xx (401 without a token, 404) are the client's fault and are not counted.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{namespace=\"todo\", status=~\"5..\"}[$__rate_interval])) or sum by (job) (rate(http_server_requests_seconds_count{namespace=\"todo\"}[$__rate_interval])) * 0",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Database pool (HikariCP, max 10 per pod)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries",
      "title": "Connections in use",
      "description": "Gauge: connections borrowed right now. 10 = this pod's pool is full.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (hikaricp_connections_active{namespace=\"todo\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests waiting for a connection",
      "description": "Anything above 0 means the pool is the bottleneck: requests queue until a connection is free (and fail after 30 s).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (hikaricp_connections_pending{namespace=\"todo\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Resources (limit 512 MiB per pod)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "type": "timeseries",
      "title": "Pod memory (whole container)",
      "description": "What the kernel counts against the 512 MiB limit; above it the container is OOM-killed.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod_name) (kubernetes_io:container_memory_used_bytes{monitored_resource=\"k8s_container\", namespace_name=\"todo\", memory_type=\"non-evictable\"})",
          "legendFormat": "{{pod_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap used",
      "description": "The part of the pod memory that holds the application's objects; grows with load. Max heap = 60 % of the limit.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (jvm_memory_used_bytes{namespace=\"todo\", area=\"heap\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU (cores)",
      "description": "1 = one full CPU core. The pods request 0.1 and have no CPU limit.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod_name) (rate(kubernetes_io:container_cpu_core_usage_time{monitored_resource=\"k8s_container\", namespace_name=\"todo\"}[$__rate_interval]))",
          "legendFormat": "{{pod_name}}"
        }
      ]
    }
  ]
}
