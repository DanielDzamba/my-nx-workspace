# Copy to java-api.secrets.env (git-ignored) and fill in. The same values as in the Render
# dashboard of danieldzamba-java-api. No quotes around the values.
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>.neon.tech/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_RABBITMQ_ADDRESSES=amqps://<user>:<password>@<host>/<vhost>