# Copy to notification-service.secrets.env (git-ignored) and fill in. The same values as in the
# Render dashboard of danieldzamba-notification-service. No quotes around the values.
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>.neon.tech/notifications?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_RABBITMQ_ADDRESSES=amqps://<user>:<password>@<host>/<vhost>
